<Application x:Class="Aura.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" ShutdownMode="OnExplicitShutdown">
  <Application.Resources>
    <SolidColorBrush x:Key="Mica" Color="#E6202630"/>
    <SolidColorBrush x:Key="MicaBorder" Color="#14FFFFFF"/>
    <SolidColorBrush x:Key="Text" Color="#F3F4F6"/>
    <SolidColorBrush x:Key="Muted" Color="#9AA3B2"/>
    <SolidColorBrush x:Key="Accent" Color="#60A5FA"/>
    <SolidColorBrush x:Key="CardBg" Color="#0AFFFFFF"/>
    <SolidColorBrush x:Key="CardHover" Color="#2E60A5FA"/>
    <FontFamily x:Key="Ui">Segoe UI Variable Text, Segoe UI</FontFamily>
    <Style x:Key="Card" TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Margin" Value="0,0,0,8"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" CornerRadius="12" Padding="12" Background="{StaticResource CardBg}" BorderThickness="1" BorderBrush="Transparent">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Background" Value="{StaticResource CardHover}"/>
                <Setter TargetName="b" Property="BorderBrush" Value="#5960A5FA"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Ghost" TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource Muted}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" CornerRadius="6" Padding="6,2" Background="Transparent"><ContentPresenter/></Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#10FFFFFF"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Application.Resources>
</Application>
