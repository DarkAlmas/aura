<Window x:Class="Aura.LookIndicator" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" Topmost="True" ShowInTaskbar="False" ShowActivated="False" SizeToContent="WidthAndHeight"
        ResizeMode="NoResize" FontFamily="{StaticResource Ui}">
  <Border CornerRadius="999" Background="{StaticResource Mica}" BorderBrush="{StaticResource MicaBorder}" BorderThickness="1" Padding="12,7" Margin="12">
    <Border.Effect><DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.45"/></Border.Effect>
    <StackPanel Orientation="Horizontal">
      <Ellipse x:Name="Dot" Width="8" Height="8" Fill="{StaticResource Accent}" VerticalAlignment="Center" Margin="0,0,8,0"/>
      <TextBlock x:Name="Label" Foreground="{StaticResource Text}" FontSize="12" VerticalAlignment="Center" Text="Смотрю"/>
      <Button Style="{StaticResource Ghost}" Margin="8,0,0,0" Click="Pause_Click"><TextBlock FontSize="12" Text="Пауза"/></Button>
    </StackPanel>
  </Border>
</Window>
