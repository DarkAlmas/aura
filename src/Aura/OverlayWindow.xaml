<Window x:Class="Aura.OverlayWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" Topmost="True" ShowInTaskbar="False" Width="364" SizeToContent="Height"
        ResizeMode="NoResize" FontFamily="{StaticResource Ui}" Title="Aura">
  <Border x:Name="Panel" CornerRadius="14" Background="{StaticResource Mica}" BorderBrush="{StaticResource MicaBorder}" BorderThickness="1" Padding="14" Margin="12">
    <Border.Effect><DropShadowEffect BlurRadius="40" ShadowDepth="12" Opacity="0.45"/></Border.Effect>
    <StackPanel>
      <Grid Margin="0,0,0,10">
        <StackPanel>
          <TextBlock x:Name="Ctx" Text="AURA" FontSize="11" Foreground="{StaticResource Muted}"/>
          <TextBlock Text="Aura" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource Text}" Margin="0,2,0,0"/>
        </StackPanel>
        <Button Style="{StaticResource Ghost}" HorizontalAlignment="Right" VerticalAlignment="Top" Click="Close_Click"><TextBlock Text="×" FontSize="16"/></Button>
      </Grid>

      <Border CornerRadius="12" Padding="12" Background="{StaticResource CardBg}" Margin="0,0,0,8">
        <StackPanel>
          <StackPanel Orientation="Horizontal"><TextBlock Text="🎯" FontSize="16" Width="36"/><TextBlock Text="Найти и нажать" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource Text}"/></StackPanel>
          <Grid Margin="36,6,0,0">
            <TextBox x:Name="FindBox" Margin="0,0,70,0" Padding="4,3" FontSize="12" ToolTip="Название кнопки (пусто — все)" KeyDown="FindBox_KeyDown"/>
            <Button Style="{StaticResource Ghost}" HorizontalAlignment="Right" Click="Find_Click"><TextBlock Text="Найти" Foreground="{StaticResource Accent}"/></Button>
          </Grid>
          <ListBox x:Name="Matches" Margin="36,6,0,0" MaxHeight="140" FontSize="12" Visibility="Collapsed" SelectionChanged="Matches_SelectionChanged"/>
          <TextBlock x:Name="FindInfo" Margin="36,6,0,0" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource Muted}" Text="Ищу через UI Automation в активном окне. Скрин не снимаю."/>
          <CheckBox x:Name="OcrChk" Margin="36,6,0,0" FontSize="11" Foreground="{StaticResource Muted}" Content="OCR если UIA не нашёл (снимок только этого окна, в памяти)"/>
          <WrapPanel Margin="36,6,0,0">
            <Button x:Name="PressBtn" Style="{StaticResource Ghost}" Click="Press_Click" IsEnabled="False"><TextBlock Text="Нажать" FontWeight="SemiBold" Foreground="{StaticResource Accent}"/></Button>
            <Button x:Name="StopBtn" Style="{StaticResource Ghost}" Click="Stop_Click" Visibility="Collapsed"><TextBlock Text="Стоп" Foreground="OrangeRed"/></Button>
            <Button x:Name="RememberBtn" Style="{StaticResource Ghost}" Click="Remember_Click" IsEnabled="False"><TextBlock Text="Запомнить" Foreground="{StaticResource Accent}"/></Button>
            <ComboBox x:Name="ActCombo" Margin="6,2,0,0" FontSize="11" Width="92" SelectedIndex="0" ToolTip="Что делать с кнопкой (Нажать / действовать / серия)" SelectionChanged="ActCombo_Changed">
              <ComboBoxItem Content="Клик"/><ComboBoxItem Content="Двойной"/><ComboBoxItem Content="Правый (ПКМ)"/>
            </ComboBox>
          </WrapPanel>
          <WrapPanel Margin="36,6,0,0">
            <Button Style="{StaticResource Ghost}" Click="UnderCursor_Click" ToolTip="Без хуков: через 3 с прочитаю кнопку под мышью (UIA, или OCR рядом с курсором) и запомню. Хоткей — сразу."><TextBlock x:Name="UnderText" Text="🖱 Под курсором" Foreground="{StaticResource Accent}"/></Button>
            <CheckBox x:Name="TplChk" Margin="8,4,0,0" FontSize="11" Foreground="{StaticResource Muted}" Content="запомнить картинку" ToolTip="Сохраню маленький PNG кнопки (≤120×60) в %AppData%\Aura\templates — для поиска по картинке, если нет ни UIA, ни текста."/>
          </WrapPanel>
        </StackPanel>
      </Border>
      <Border CornerRadius="12" Padding="12" Background="{StaticResource CardBg}">
        <StackPanel>
          <StackPanel Orientation="Horizontal"><TextBlock Text="🎓" FontSize="16" Width="36"/><TextBlock Text="Выученные кнопки" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource Text}"/>
            <TextBlock x:Name="LearnBadge" Margin="8,2,0,0" FontSize="12" FontWeight="Bold" Foreground="Red" Text="● Учусь" Visibility="Collapsed"/></StackPanel>
          <TextBlock x:Name="LearnInfo" Margin="36,4,0,0" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource Muted}" Text="Найди кнопку выше и «Запомнить» (или включи «Учусь» — тогда каждое «Нажать» запоминает). Свои клики мышью я не слежу."/>
          <WrapPanel Margin="36,6,0,0">
            <Button x:Name="LearnBtn" Style="{StaticResource Ghost}" Click="Learn_Click"><TextBlock x:Name="LearnBtnText" Text="● Учусь" Foreground="{StaticResource Accent}"/></Button>
            <CheckBox x:Name="ActChk" Margin="8,4,0,0" FontSize="11" Foreground="{StaticResource Muted}" Content="действовать (сам жму выученные)" ToolTip="Выкл. по умолчанию. Каждые 2 с читаю UIA активного окна; совпадение → «Делаю» 1 с со Стоп/Esc/Пауза → клик." Checked="ActChk_Changed" Unchecked="ActChk_Changed"/>
          </WrapPanel>
          <CheckBox x:Name="OnlyAppChk" Margin="36,4,0,0" FontSize="11" Foreground="{StaticResource Muted}" Content="только это приложение"/>
          <CheckBox x:Name="AppOffChk" Margin="36,4,0,0" FontSize="11" Foreground="{StaticResource Muted}" Content="не действовать в этом приложении"/>
          <ListBox x:Name="BtnList" Margin="36,6,0,0" MaxHeight="140" FontSize="12" Visibility="Collapsed"/>
          <WrapPanel x:Name="BtnBar" Margin="36,6,0,0" Visibility="Collapsed">
            <Button Style="{StaticResource Ghost}" Click="BtnDelete_Click"><TextBlock Text="Удалить" Foreground="{StaticResource Muted}"/></Button>
            <Button Style="{StaticResource Ghost}" Click="BtnClear_Click"><TextBlock Text="Очистить всё" Foreground="{StaticResource Muted}"/></Button>
            <Button Style="{StaticResource Ghost}" Click="BtnRun_Click"><TextBlock Text="▶ Нажать" Foreground="{StaticResource Accent}"/></Button>
            <Button Style="{StaticResource Ghost}" Click="BtnSeries_Click" ToolTip="Все выученные кнопки этого окна по порядку, каждая с «Делаю» 1 с"><TextBlock Text="⏩ Серия" Foreground="{StaticResource Accent}"/></Button>
            <Button Style="{StaticResource Ghost}" Click="BtnToggle_Click" ToolTip="Вкл/выкл кнопку для «действовать»"><TextBlock Text="вкл/выкл" Foreground="{StaticResource Muted}"/></Button>
            <Button Style="{StaticResource Ghost}" Click="BtnStartup_Click" ToolTip="Добавить выбранную кнопку в «При старте»"><TextBlock Text="+ при старте" Foreground="{StaticResource Muted}"/></Button>
          </WrapPanel>
        </StackPanel>
      </Border>
      <Border CornerRadius="12" Padding="12" Background="{StaticResource CardBg}" Margin="0,8,0,0">
        <Expander x:Name="AiExp" IsExpanded="False">
          <Expander.Header><StackPanel Orientation="Horizontal"><TextBlock Text="🤖" FontSize="16" Width="30"/><TextBlock Text="ИИ — скажи что сделать" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource Text}"/></StackPanel></Expander.Header>
          <StackPanel Margin="6,6,0,0">
            <WrapPanel>
              <CheckBox x:Name="AiChk" FontSize="11" Foreground="{StaticResource Muted}" Content="ИИ (сеть)" ToolTip="Выкл. по умолчанию. Только при «Спросить»: имя приложения, заголовок, имена выученных кнопок и твой запрос → ИИ (как в circuit: бесплатный Groq-прокси или Ollama)."/>
              <CheckBox x:Name="AiTextChk" Margin="8,0,0,0" FontSize="11" Foreground="{StaticResource Muted}" Content="приложить текст окна (OCR)"/>
              <ComboBox x:Name="AiBackend" Margin="8,-2,0,0" FontSize="11" Width="96" SelectionChanged="AiBackend_Changed"><ComboBoxItem Content="Groq-прокси"/><ComboBoxItem Content="Ollama"/><ComboBoxItem Content="свой URL"/></ComboBox>
            </WrapPanel>
            <Grid Margin="0,6,0,0">
              <TextBox x:Name="AskBox" Margin="0,0,80,0" Padding="4,3" FontSize="12" TextWrapping="Wrap" AcceptsReturn="False" KeyDown="AskBox_KeyDown" ToolTip="Напр.: «нажми Войти дважды», «открой блокнот», «что тут можно сделать?»"/>
              <Button x:Name="AskBtn" Style="{StaticResource Ghost}" HorizontalAlignment="Right" Click="Ask_Click"><TextBlock Text="Спросить" Foreground="{StaticResource Accent}"/></Button>
            </Grid>
            <WrapPanel Margin="0,4,0,0">
              <Button Style="{StaticResource Ghost}" Tag="Что тут можно сделать? Предложи 3 полезных действия." Click="AiChip_Click"><TextBlock Text="Что тут можно?" FontSize="11" Foreground="{StaticResource Muted}"/></Button>
              <Button Style="{StaticResource Ghost}" Tag="Предложи 2-3 правила «вижу → предложить» для этого приложения (команды RULE)." Click="AiChip_Click"><TextBlock Text="💡 Правила" FontSize="11" Foreground="{StaticResource Muted}"/></Button>
              <Button Style="{StaticResource Ghost}" Tag="Какие кнопки здесь стоит запомнить? Предложи REMEMBER для самых частых." Click="AiChip_Click"><TextBlock Text="Что запомнить?" FontSize="11" Foreground="{StaticResource Muted}"/></Button>
              <Button Style="{StaticResource Ghost}" Tag="Объясни простыми словами, что это за окно и что в нём главное." Click="AiChip_Click"><TextBlock Text="Объясни окно" FontSize="11" Foreground="{StaticResource Muted}"/></Button>
            </WrapPanel>
            <ScrollViewer x:Name="AiScroll" Margin="0,6,0,0" MaxHeight="180" VerticalScrollBarVisibility="Auto"><TextBlock x:Name="AiReply" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource Text}"/></ScrollViewer>
            <ListBox x:Name="IntentList" Margin="0,6,0,0" MaxHeight="110" FontSize="12" SelectionMode="Multiple" Visibility="Collapsed"/>
            <WrapPanel x:Name="IntentBar" Margin="0,4,0,0" Visibility="Collapsed">
              <Button Style="{StaticResource Ghost}" Click="RunIntents_Click"><TextBlock Text="Выполнить отмеченные" FontWeight="SemiBold" Foreground="{StaticResource Accent}"/></Button>
            </WrapPanel>
            <Button Style="{StaticResource Ghost}" HorizontalAlignment="Left" Click="AiReset_Click"><TextBlock Text="Новый чат" Foreground="{StaticResource Muted}"/></Button>
          </StackPanel>
        </Expander>
      </Border>
      <Border CornerRadius="12" Padding="12" Background="{StaticResource CardBg}" Margin="0,8,0,0">
        <Expander x:Name="StartExp" IsExpanded="False">
          <Expander.Header><StackPanel Orientation="Horizontal"><TextBlock Text="⚡" FontSize="16" Width="30"/><TextBlock Text="При старте Aura" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource Text}"/></StackPanel></Expander.Header>
          <StackPanel Margin="6,6,0,0">
            <CheckBox x:Name="StartChk" FontSize="11" Foreground="{StaticResource Muted}" Content="выполнять при запуске Aura (клики — с «Делаю» 1 с)"/>
            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
              <TextBlock Text="Пауза между шагами (серия/старт/ИИ), мс:" FontSize="11" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
              <TextBox x:Name="DelayBox" Width="56" Margin="6,0,0,0" Padding="2" FontSize="11" LostFocus="DelayBox_LostFocus"/>
              <CheckBox x:Name="SoundChk" Margin="10,0,0,0" FontSize="11" Foreground="{StaticResource Muted}" Content="звук клика"/>
            </StackPanel>
            <Grid Margin="0,6,0,0">
              <ComboBox x:Name="StartKind" Width="96" HorizontalAlignment="Left" FontSize="11" SelectedIndex="0"><ComboBoxItem Content="Запустить"/><ComboBoxItem Content="Открыть URL"/><ComboBoxItem Content="Нажать"/><ComboBoxItem Content="Ждать, с"/></ComboBox>
              <TextBox x:Name="StartArg" Margin="100,0,70,0" Padding="4,2" FontSize="12" ToolTip="Путь к .exe / https://… / имя выученной кнопки / секунды"/>
              <Button Style="{StaticResource Ghost}" HorizontalAlignment="Right" Click="StartAdd_Click"><TextBlock Text="Добавить" Foreground="{StaticResource Accent}"/></Button>
            </Grid>
            <ListBox x:Name="StartList" Margin="0,6,0,0" MaxHeight="110" FontSize="12"/>
            <WrapPanel Margin="0,4,0,0">
              <Button Style="{StaticResource Ghost}" Click="StartDel_Click"><TextBlock Text="Удалить" Foreground="{StaticResource Muted}"/></Button>
              <Button Style="{StaticResource Ghost}" Click="StartRun_Click"><TextBlock Text="▶ Проверить сейчас" Foreground="{StaticResource Accent}"/></Button>
            </WrapPanel>
          </StackPanel>
        </Expander>
      </Border>
      <Border CornerRadius="12" Padding="12" Background="{StaticResource CardBg}" Margin="0,8,0,0">
        <Expander x:Name="RuleExp" IsExpanded="False">
          <Expander.Header><StackPanel Orientation="Horizontal"><TextBlock Text="💡" FontSize="16" Width="30"/><TextBlock Text="Правила: вижу → предложить" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource Text}"/></StackPanel></Expander.Header>
          <StackPanel Margin="6,6,0,0">
            <TextBlock FontSize="11" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Text="Только подсказки: сами ничего не нажимают. «▶» — с «Делаю» 1 с + Стоп."/>
            <ListBox x:Name="RuleHits" Margin="0,6,0,0" MaxHeight="80" FontSize="12" Visibility="Collapsed"/>
            <Button x:Name="RuleHitRun" Style="{StaticResource Ghost}" HorizontalAlignment="Left" Click="RuleHitRun_Click" Visibility="Collapsed"><TextBlock Text="▶ Сделать предложенное" FontWeight="SemiBold" Foreground="{StaticResource Accent}"/></Button>
            <CheckBox x:Name="RulesChk" Margin="0,4,0,0" FontSize="11" Foreground="{StaticResource Muted}" Content="подсказывать в фоне (тост, раз в 60 с на правило)"/>
            <Grid Margin="0,6,0,0">
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
              <ComboBox x:Name="RuleWhen" IsEditable="True" FontSize="12" ToolTip="Вижу текст (кнопка/надпись в окне) — впиши или выбери из текущего окна" DropDownOpened="RuleWhen_DropDown"/>
              <TextBlock Grid.Column="1" Text=" → " VerticalAlignment="Center" Foreground="{StaticResource Muted}"/>
              <ComboBox x:Name="RuleSuggest" Grid.Column="2" IsEditable="True" FontSize="12" ToolTip="Предложить нажать (имя кнопки) — список: выученные кнопки этого приложения" DropDownOpened="RuleSuggest_DropDown"/>
            </Grid>
            <WrapPanel Margin="0,2,0,0">
              <TextBlock Text="Шаблоны:" FontSize="11" VerticalAlignment="Center" Foreground="{StaticResource Muted}"/>
              <Button Style="{StaticResource Ghost}" Tag="cookie|Принять" Click="RulePreset_Click"><TextBlock Text="cookies" FontSize="11" Foreground="{StaticResource Muted}"/></Button>
              <Button Style="{StaticResource Ghost}" Tag="Сохранить изменения|Сохранить" Click="RulePreset_Click"><TextBlock Text="сохранить?" FontSize="11" Foreground="{StaticResource Muted}"/></Button>
              <Button Style="{StaticResource Ghost}" Tag="Доступно обновление|Позже" Click="RulePreset_Click"><TextBlock Text="обновление" FontSize="11" Foreground="{StaticResource Muted}"/></Button>
              <Button Style="{StaticResource Ghost}" Tag="Продолжить просмотр|Продолжить" Click="RulePreset_Click"><TextBlock Text="продолжить?" FontSize="11" Foreground="{StaticResource Muted}"/></Button>
            </WrapPanel>
            <WrapPanel Margin="0,4,0,0">
              <CheckBox x:Name="RuleThisApp" IsChecked="True" FontSize="11" Foreground="{StaticResource Muted}" Content="только в этом приложении" VerticalAlignment="Center"/>
              <Button Style="{StaticResource Ghost}" Click="RuleAdd_Click"><TextBlock Text="Добавить" Foreground="{StaticResource Accent}"/></Button>
              <Button Style="{StaticResource Ghost}" Click="RuleToggle_Click"><TextBlock Text="вкл/выкл" Foreground="{StaticResource Muted}"/></Button>
              <Button Style="{StaticResource Ghost}" Click="RuleDel_Click"><TextBlock Text="Удалить" Foreground="{StaticResource Muted}"/></Button>
            </WrapPanel>
            <ListBox x:Name="RuleList" Margin="0,4,0,0" MaxHeight="110" FontSize="12"/>
          </StackPanel>
        </Expander>
      </Border>
      <Border CornerRadius="12" Padding="12" Background="{StaticResource CardBg}" Margin="0,8,0,0">
        <Expander x:Name="NoTouchExp" IsExpanded="False">
          <Expander.Header><StackPanel Orientation="Horizontal"><TextBlock Text="🚫" FontSize="16" Width="30"/><TextBlock Text="Не трогать" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource Text}"/></StackPanel></Expander.Header>
          <StackPanel Margin="6,6,0,0">
            <TextBlock FontSize="11" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Text="🔒 исключено — Aura не читает и не жмёт вообще (пароли, банки). ✋ не действовать — «действовать» молчит, ручные команды работают."/>
            <Grid Margin="0,6,0,0">
              <TextBox x:Name="NtName" Margin="0,0,0,0" Padding="4,2" FontSize="12" ToolTip="Имя процесса без .exe, например chrome"/>
            </Grid>
            <WrapPanel Margin="0,4,0,0">
              <Button Style="{StaticResource Ghost}" Click="NtCurrent_Click"><TextBlock x:Name="NtCurText" Text="← текущее" Foreground="{StaticResource Muted}"/></Button>
              <Button Style="{StaticResource Ghost}" Click="NtExclude_Click"><TextBlock Text="🔒 исключить" Foreground="{StaticResource Accent}"/></Button>
              <Button Style="{StaticResource Ghost}" Click="NtNoAct_Click"><TextBlock Text="✋ не действовать" Foreground="{StaticResource Accent}"/></Button>
              <Button Style="{StaticResource Ghost}" Click="NtDel_Click"><TextBlock Text="Убрать" Foreground="{StaticResource Muted}"/></Button>
            </WrapPanel>
            <ListBox x:Name="NtList" Margin="0,4,0,0" MaxHeight="120" FontSize="12"/>
          </StackPanel>
        </Expander>
      </Border>
      <Grid Margin="0,10,0,0">
        <Border CornerRadius="6" Background="#10FFFFFF" Padding="6,2" HorizontalAlignment="Left">
          <TextBlock x:Name="HotkeyHint" Text="Win+Shift+Z" FontFamily="Consolas" FontSize="10" Foreground="{StaticResource Muted}"/></Border>
        <TextBlock x:Name="Status" HorizontalAlignment="Right" Margin="0,0,0,0" FontSize="11" Foreground="{StaticResource Muted}"/>
      </Grid>
    </StackPanel>
  </Border>
</Window>
